# Copy to .env and fill in. Never commit .env.
# Required: 16+ characters. Generate with: openssl rand -hex 24
CYB_ACCESS_KEY=
# The https address phones use. Needed for Google/GitHub sign-in
# (redirect address is <url>/v1/oauth/callback).
CYB_PUBLIC_URL=
# 64 hex characters encrypting secrets/tokens. Generate: openssl rand -hex 32
# If unset, a key file is created next to the data (less safe). Losing this
# key makes stored secrets unreadable — back it up somewhere safe.
CYB_MASTER_KEY=
# Optional sign-in providers (Web application OAuth clients):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
